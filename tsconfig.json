{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": ["main.ts", "scene/**/*.ts", "objects/**/*.ts", "player/**/*.ts", "chat/**/*.ts", "vite.config.ts"]
}
